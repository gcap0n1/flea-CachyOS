# Contributor: GM (upstream Flea, https://github.com/thisisgm/flea)

# Flea for CachyOS: upstream's `make install` without Omarchy. Since 0.4.0 the window is flea-gui (GPUI),
# which reads its colours from ~/.local/state/omarchy/current/theme/colors.toml: Noctalia renders that
# file through packaging/noctalia, and each user runs flea-cachyos-setup once. ui/Commons and ui/Ui are
# this fork's own directories, so nothing links into /usr/share/omarchy. Omarchy's language roster
# ships under /usr/share/flea/omarchy (src/i18n/mod.rs). It provides and conflicts with dolphin, so
# installing it replaces Dolphin in one transaction while cachyos-hypr-noctalia keeps its dependency.
pkgname=flea-cachyos
pkgver=0.3.9.r0
pkgrel=1
pkgdesc='Fast, keyboard-first file manager: Flea ported to CachyOS, Hyprland and Noctalia'
arch=('x86_64')
url='https://github.com/gcap0n1/flea-CachyOS'
license=('GPL-3.0-only' 'MIT' 'Apache-2.0' 'BSD-2-Clause' 'BSD-3-Clause' 'CC0-1.0' 'ISC' 'MPL-2.0' 'Unicode-3.0' 'Zlib' 'LGPL-3.0-or-later' 'EPL-2.0')
depends=('bat' 'bubblewrap' 'expect' 'fontconfig' 'gcc-libs' 'gdk-pixbuf2' 'glib2' 'glibc' 'gvfs' 'gvfs-afc' 'gvfs-dnssd' 'gvfs-gphoto2' 'gvfs-mtp' 'gvfs-nfs' 'gvfs-smb' 'hicolor-icon-theme' 'jq' 'libglvnd' 'libheif' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'mpv' 'poppler-glib' 'python' 'python-gobject' 'qt6-declarative' 'qt6-webengine' 'quickjs-ng' 'ripgrep' 'shared-mime-info' 'udisks2' 'usbmuxd' 'util-linux' 'vulkan-driver' 'vulkan-icd-loader' 'wayland' 'wl-clipboard' 'xdg-terminal-exec' 'xdg-utils')
makedepends=('cargo' 'git' 'pkgconf')
optdepends=('libarchive: archive listing and extraction'
            '7zip: 7z archive support'
            'imagemagick: image conversion'
            'libreoffice: office document previews'
            'tailscale: Taildrop sharing'
            'ffmpeg: media metadata in the preview column'
            'ffmpegthumbnailer: video thumbnails'
            'dropbox-cli: Dropbox share links'
            'zoxide: frecent folders in the folder jump of the path bar')
provides=('flea' 'dolphin')
conflicts=('flea' 'flea-bin' 'flea-git' 'dolphin')
options=('!debug' '!lto')
source=("$pkgname::git+https://github.com/gcap0n1/flea-CachyOS.git#branch=cachyos")
sha256sums=('SKIP')

# The upstream release from Cargo.toml, plus the commit count and hash: this fork never carries
# upstream's v* tags (their release workflow publishes on them), so git describe cannot be used.
pkgver() {
  cd "$pkgname"
  printf '%s.r%s.g%s' "$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -n1)" \
    "$(git rev-list --count HEAD)" "$(git rev-parse --short=8 HEAD)"
}

build() {
  export CARGO_TARGET_DIR="$srcdir/target"
  cd "$pkgname"
  cargo build --release --locked --workspace --bins
}

package() {
  cd "$pkgname"
  # Upstream's install, from the binaries build() left in $srcdir/target.
  ln -sfn "$srcdir/target" target
  make DESTDIR="$pkgdir" VERSION="$pkgver-$pkgrel" install
  rm target

  # This fork's Commons and Ui in place of the links into /usr/share/omarchy/shell.
  rm "$pkgdir"/usr/share/flea/ui/{,boot/}{Commons,Ui}
  install -Dm644 ui/Commons/qmldir ui/Commons/*.qml -t "$pkgdir/usr/share/flea/ui/Commons"
  install -Dm644 ui/Ui/qmldir ui/Ui/*.qml -t "$pkgdir/usr/share/flea/ui/Ui"
  ln -s ../Commons "$pkgdir/usr/share/flea/ui/boot/Commons"
  ln -s ../Ui "$pkgdir/usr/share/flea/ui/boot/Ui"

  # Omarchy's language roster and English shell strings, which src/i18n/mod.rs reads here without Omarchy.
  install -Dm644 src/i18n/fixtures/locales.json -t "$pkgdir/usr/share/flea/omarchy/default/i18n"
  install -Dm644 src/i18n/fixtures/omarchy/default/i18n/en/*.json -t "$pkgdir/usr/share/flea/omarchy/default/i18n/en"

  # Licences under this package's name, and the fork's own hook, setup and Noctalia template.
  mv "$pkgdir/usr/share/licenses/flea" "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 LICENSE-MIT NOTICE.md -t "$pkgdir/usr/share/licenses/$pkgname"
  rm "$pkgdir/usr/share/libalpm/hooks/flea.hook"
  install -Dm644 packaging/flea-cachyos/flea-cachyos.hook -t "$pkgdir/usr/share/libalpm/hooks"
  install -Dm755 scripts/flea-cachyos-setup -t "$pkgdir/usr/bin"
  install -Dm644 packaging/noctalia/flea-colors.toml packaging/noctalia/flea.toml -t "$pkgdir/usr/share/flea/noctalia"
}
