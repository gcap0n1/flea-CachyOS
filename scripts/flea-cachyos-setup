#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only
# The per-user half of flea-cachyos, which pacman cannot do for each home.
#   flea-cachyos-setup        Noctalia renders Flea's palette, Flea speaks the system language, folders
#                             open in Flea, and Open/Save dialogs go through Flea's portal
#   flea-cachyos-setup off    undo all of it (folders go back to Dolphin when it is installed)
set -eu

share=/usr/share/flea/noctalia
noctalia_conf="${XDG_CONFIG_HOME:-$HOME/.config}/noctalia/flea.toml"
entry=com.thisisgm.flea.desktop
portal_conf="${XDG_CONFIG_HOME:-$HOME/.config}/xdg-desktop-portal/portals.conf"
language_file="${XDG_CONFIG_HOME:-$HOME/.config}/flea/language"
roster=/usr/share/flea/omarchy/default/i18n/locales.json

say() { printf 'flea-cachyos-setup: %s\n' "$*"; }

on() {
  mkdir -p "$(dirname "$noctalia_conf")"
  cp "$share/flea.toml" "$noctalia_conf.tmp"
  mv -f "$noctalia_conf.tmp" "$noctalia_conf"
  say "Noctalia template installed: $noctalia_conf"
  if command -v noctalia >/dev/null && noctalia msg config-reload >/dev/null 2>&1; then
    say "Noctalia reloaded; Flea follows its palette from now on"
  else
    say "Noctalia is not running; the palette is rendered on its next start"
  fi
  # Omarchy writes its language to ~/.config/omarchy/language; this fork reads ~/.config/flea/language
  # in the same shape (src/i18n/mod.rs). Sample: LANG=pt_BR.UTF-8 gives pt-BR, LANG=it_IT.UTF-8 gives it.
  if [ ! -s "$language_file" ]; then
    local locale lang region code=en
    locale="${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}"
    locale="${locale%%.*}"; locale="${locale%%@*}"
    lang="${locale%%_*}"; region="${locale#*_}"
    if [ "$region" != "$locale" ] && jq -e --arg c "$lang-$region" 'has($c)' "$roster" >/dev/null 2>&1; then
      code="$lang-$region"
    elif jq -e --arg c "$lang" 'has($c)' "$roster" >/dev/null 2>&1; then
      code="$lang"
    fi
    mkdir -p "$(dirname "$language_file")"
    printf '%s\n' "$code" > "$language_file"
  fi
  say "Flea's language: $(head -n1 "$language_file") (change it in $language_file)"
  xdg-mime default "$entry" inode/directory
  say "folders open in Flea ($(xdg-mime query default inode/directory))"
  # flea --picker writes a user portals.conf holding only the FileChooser line. That file overrides the
  # desktop's own <desktop>-portals.conf, so its default= line is carried over, or screenshots and
  # screen sharing would lose their backend. The Omarchy key-binding half of flea --picker fails here.
  flea --picker >/dev/null 2>&1 || true
  local desktop system line
  desktop=$(printf '%s' "${XDG_CURRENT_DESKTOP:-}" | cut -d: -f1 | tr '[:upper:]' '[:lower:]')
  system="/usr/share/xdg-desktop-portal/${desktop}-portals.conf"
  if [ -f "$portal_conf" ] && ! grep -q '^default=' "$portal_conf" && [ -f "$system" ]; then
    line=$(grep -m1 '^default=' "$system" || true)
    [ -n "$line" ] && sed -i "/^\[preferred\]/a $line" "$portal_conf"
  fi
  systemctl --user restart xdg-desktop-portal 2>/dev/null || true
  say "Open/Save dialogs go through Flea ($(grep -m1 FileChooser "$portal_conf" 2>/dev/null))"
}

off() {
  flea --picker off >/dev/null 2>&1 || true
  systemctl --user restart xdg-desktop-portal 2>/dev/null || true
  say "Open/Save dialogs back to the desktop's own"
  rm -f "$noctalia_conf"
  say "Noctalia template removed"
  rm -f "$language_file"
  say "Flea's language file removed"
  if [ -e /usr/share/applications/org.kde.dolphin.desktop ]; then
    xdg-mime default org.kde.dolphin.desktop inode/directory
    say "folders open in Dolphin again"
  else
    say "Dolphin is not installed (sudo pacman -S dolphin), so the folder default is left as it is"
  fi
}

case "${1:-on}" in
  on) on ;;
  off) off ;;
  *) echo "usage: flea-cachyos-setup [on|off]" >&2; exit 2 ;;
esac
